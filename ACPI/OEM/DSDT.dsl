            Offset (0x05),
            Offset (0x06),
            IERC,   8,
            Offset (0x08),
            Offset (0x80),
            IWB0,   32,
            IWB1,   32,
            IWB2,   32,
            IWB3,   32,
            IRB0,   32,
            IRB1,   32,
            IRB2,   32,
            IRB3,   32,
            Offset (0x10D0),
            RAA0,   1,
            RAA1,   1,
            RAA2,   1,
            RAA3,   1,
            RPB0,   1,
            RPB1,   1,
            RPB2,   1,
            RPB3,   1,
            RPC0,   1,
            RPC1,   1,
            RPC2,   1,
            RPC3,   1,
            RSAT,   1,
            RGBE,   1,
            RXHC,   1,
            RXDC,   1,
            RUFS,   1,
            RPD0,   1,
            RPD1,   1,
            RPD2,   1,
            RPD3,   1,
            RPE0,   1,
            RPE1,   1,
            RPE2,   1,
            RPE3,   1,
            Offset (0x10D4),
            APA0,   1,
            APA1,   1,
            APA2,   1,
            APA3,   1,
            APB0,   1,
            APB1,   1,
            APB2,   1,
            APB3,   1,
            APC0,   1,
            APC1,   1,
            APC2,   1,
            APC3,   1,
            ASAT,   1,
            AGBE,   1,
            AXHC,   1,
            AXDC,   1,
            AUFS,   1,
            APD0,   1,
            APD1,   1,
            APD2,   1,
            APD3,   1,
            APE0,   1,
            APE1,   1,
            APE2,   1,
            APE3,   1,
            Offset (0x1800),
            ACWA,   32,
