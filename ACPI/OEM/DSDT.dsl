                    If ((Arg1 == Zero))
                    {
                        Return (Buffer (One)
                        {
                             0x17                                             // .
                        })
                    }
                    Else
                    {
                        Return (Buffer (One)
                        {
                             0x00                                             // .
                        })
                    }
                }

                If ((Arg2 == One))
                {
                    Local0 = Zero
                    Return (Local0)
                }

                If ((Arg2 == 0x02))
                {
                    Local0 = Zero
                    Return (Local0)
                }

                If ((Arg2 == 0x03))
                {
                    Local0 = Zero
                    Return (Local0)
