        Method (WPMD, 1, Serialized)
        {
            If (CondRefOf (\_SB.PC00.LPCB.H_EC))
            {
                ^H_EC.WPED (Arg0)
            }
        }

        Method (ISPC, 0, Serialized)
        {
            If (CondRefOf (\_SB.PC00.LPCB.H_EC))
            {
                ^H_EC.SPET ()
            }
        }

        Method (ENPC, 0, NotSerialized)
