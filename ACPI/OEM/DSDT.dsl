                        ADBG ("No TYPE_PECI_PKG_PL4 Setting.")
                        Return (RETV) /* \_SB_.PC00.LPCB.EC__.HKEY.GICT.RETV */
                    }
                }
                Case (0x0A)
                {
                    If ((CondRefOf (ICTA) == Zero))
                    {
                        ADBG ("No TYPE_PECI_PSYS_PL1 Setting.")
                        Return (RETV) /* \_SB_.PC00.LPCB.EC__.HKEY.GICT.RETV */
                    }
                }
                Case (0x0B)
                {
                    If ((CondRefOf (ICTB) == Zero))
                    {
                        ADBG ("No TYPE_PECI_PSYS_PL2 Setting.")
                        Return (RETV) /* \_SB_.PC00.LPCB.EC__.HKEY.GICT.RETV */
                    }
                }
                Default
                {
                    Return (RETV) /* \_SB_.PC00.LPCB.EC__.HKEY.GICT.RETV */
                }

            }

            Name (ICCB, 0xFFFF)
            ADBG ("Fan Error Skip.")
            ICCB = (((NDPT << 0x08) | Zero) | CICF) /* \CICF */
            ADBG (Concatenate ("Get Type= ", ToHexString (Arg1)))
            ADBG (Concatenate ("NDPT= ", ToHexString (NDPT)))
            ADBG (Concatenate ("FANE= ", ToHexString (FANE)))
            ADBG (Concatenate ("CICF= ", ToHexString (CICF)))
            ADBG (Concatenate ("IcCombineData = ", ToHexString (ICCB)))
            ADBG (Concatenate ("SA DID =", ToHexString (^^^^MC.HDID)))
            Switch (ToInteger (Arg1))
            {
                Case (One)
                {
                    If (CondRefOf (ICT1))
                    {
                        Local0 = ICT1 /* \_SB_.PC00.LPCB.EC__.HKEY.ICT1 */
                    }
                }
                Case (0x03)
                {
                    If (CondRefOf (ICT3))
                    {
                        Local0 = ICT3 /* \_SB_.PC00.LPCB.EC__.HKEY.ICT3 */
                    }
                }
                Case (0x05)
                {
                    If (CondRefOf (ICT5))
                    {
                        Local0 = ICT5 /* \_SB_.PC00.LPCB.EC__.HKEY.ICT5 */
                    }
                }
                Default
                {
                    Return (RETV) /* \_SB_.PC00.LPCB.EC__.HKEY.GICT.RETV */
                }

            }

            Name (TINX, Zero)
            Name (CPSC, Zero)
            Name (CMMC, Zero)
            Name (CCQL, Zero)
            Name (CTMS, Zero)
            Name (CMYH, Zero)
            Name (GPUC, 0xFFFFFFFF)
            Name (GPUB, One)
            Name (CADM, Zero)
            Name (CPWR, Zero)
            CPWR = HPAC /* \_SB_.PC00.LPCB.EC__.HPAC */
            ADBG (Concatenate ("CPWR=", ToHexString (CPWR)))
            If (((VPSC == One) && (SPSC == One)))
            {
                CPSC = One
            }
            ElseIf (((VPSC == One) && (SPSC == 0x02)))
            {
                CPSC = 0x02
            }
            ElseIf (((VPSC == One) && (SPSC == 0x03)))
            {
                CPSC = 0x04
            }
            ElseIf (((VPSC == One) && (SPSC == 0x04)))
            {
                CPSC = 0x08
            }
            ElseIf (((VPSC == One) && (SPSC == 0x05)))
            {
                CPSC = 0x10
            }
            ElseIf (((VPSC == One) && (SPSC == 0x06)))
            {
                CPSC = 0x20
            }
            ElseIf (((VPSC == One) && (SPSC == 0x07)))
            {
                CPSC = 0x40
            }
            ElseIf (((VPSC == One) && (SPSC == 0x08)))
            {
                CPSC = 0x80
            }

            ADBG (Concatenate ("CPSC=", ToHexString (CPSC)))
            If (((VMMC == One) && (SMMC == Zero)))
            {
                CMMC = 0x1000
            }
            ElseIf (((VMMC == One) && (SMMC == One)))
            {
                CMMC = 0x2000
            }
            ElseIf (((VMMC == One) && (SMMC == 0x02)))
            {
                CMMC = 0x4000
            }
            ElseIf (((VMMC == One) && (SMMC == 0x03)))
            {
                CMMC = 0x8000
            }

            ADBG (Concatenate ("CMMC=", ToHexString (CMMC)))
            If ((VCQL == One))
            {
                CCQL = 0x0100
            }

            ADBG (Concatenate ("CCQL=", ToHexString (CCQL)))
            If (((VMYH == One) && (SMYH == Zero)))
            {
                CMYH = 0x0200
            }
            ElseIf (((VMYH == One) && (SMYH == One)))
            {
                CMYH = 0x0400
            }
            ElseIf (((VMYH == One) && (SMYH == 0x02)))
            {
                CMYH = 0x0800
            }

            ADBG (Concatenate ("CMYH=", ToHexString (CMYH)))
            If ((GVDI == 0xFFFFFFFF))
            {
                GPUC = Zero
            }
            Else
            {
                GPUC = (GVDI >> 0x10)
            }

            ADBG (Concatenate ("GPUC=", ToHexString (GPUC)))
            Name (TMID, 0xFF)
            Name (TICF, 0xFFFF)
            Name (TICC, 0xFFFFFFFF)
            Name (TCFM, 0xFFFF)
            Name (TGID, 0xFFFF)
            Name (TGBR, 0xFF)
            Name (TSTT, 0xFF)
            Name (TSTV, Ones)
            Name (MPTS, Zero)
            Name (MPTI, Zero)
            Name (MPTD, Zero)
            Name (SPTS, Zero)
            Name (SPTI, Zero)
            MPTS = SizeOf (Local0)
            Name (CINX, Zero)
            Name (NOTF, One)
            While (((MPTI < MPTS) && NOTF))
            {
                Local1 = DerefOf (Local0 [MPTI])
                MPTD = DerefOf (Local1 [Zero])
                If ((MPTD != 0xFFFFFFFF))
                {
                    If ((MPTD != MPID))
                    {
                        MPTI++
                        Continue
                    }
                }

                SPTS = SizeOf (Local1)
                SPTI = One
                CINX = Zero
                While (((SPTI < SPTS) && NOTF))
                {
                    Local2 = DerefOf (Local1 [SPTI])
                    Local3 = SizeOf (Local2)
                    CINX += TINX /* \_SB_.PC00.LPCB.EC__.HKEY.GICT.TINX */
                    TINX = Zero
                    While ((TINX < Local3))
                    {
                        Local4 = DerefOf (Local2 [TINX])
                        TMID = DerefOf (Local4 [Zero])
                        TICF = DerefOf (Local4 [One])
                        TICC = DerefOf (Local4 [0x02])
                        TCFM = DerefOf (Local4 [0x03])
                        TGID = DerefOf (Local4 [0x04])
                        TGBR = DerefOf (Local4 [0x05])
                        TSTT = DerefOf (Local4 [0x06])
                        TSTV = DerefOf (Local4 [0x07])
                        If ((Arg1 != TSTT))
                        {
                            TINX++
                            Continue
                        }

                        If (((TMID != 0xFFFFFFFF) && (MPID != TMID)))
                        {
                            TINX++
                            Continue
                        }

                        If (((TICF != 0xFFFFFFFF) && (ICCB != TICF)))
                        {
                            TINX++
                            Continue
                        }

                        If ((TICC != 0xFFFFFFFF))
                        {
                            If ((TICC & 0x00010000))
                            {
                                If ((CPWR != One))
                                {
                                    TINX++
                                    Continue
                                }
                            }

                            If ((TICC & 0x00020000))
                            {
                                If ((CPWR != Zero))
                                {
                                    TINX++
                                    Continue
                                }
                            }

                            If (((TICC & One) || ((TICC & 0x02) || (
                                (TICC & 0x04) || ((TICC & 0x08) || ((TICC & 0x10
                                ) || ((TICC & 0x20) || ((TICC & 0x40) || (TICC &
                                0x80)))))))))
                            {
                                If (((TICC & CPSC) == Zero))
                                {
                                    TINX++
                                    Continue
                                }
                            }

                            If (((TICC & 0x1000) || ((TICC & 0x2000) || (
                                (TICC & 0x4000) || (TICC & 0x8000)))))
                            {
                                If (((TICC & CMMC) == Zero))
                                {
                                    TINX++
                                    Continue
                                }
                            }

                            If ((TICC & 0x0100))
                            {
                                If (((TICC & CCQL) == Zero))
                                {
                                    TINX++
                                    Continue
                                }
                            }

                            If (((TICC & 0x0200) || ((TICC & 0x0400) || (
                                TICC & 0x0800))))
                            {
                                If (((TICC & CMYH) == Zero))
                                {
                                    TINX++
                                    Continue
                                }
                            }
                        }

                        If (((TCFM != 0xFFFFFFFF) && (^^^^MC.HDID != TCFM)))
                        {
                            TINX++
                            Continue
                        }

                        If ((TGID != 0xFFFFFFFF))
                        {
                            If ((TGID == Zero))
                            {
                                If ((GPUC != Zero))
                                {
                                    TINX++
                                    Continue
                                }
                            }
                            ElseIf ((TGID == One))
                            {
                                If ((GPUC == Zero))
                                {
                                    TINX++
                                    Continue
                                }
                            }
                            ElseIf ((TGID != GPUC))
                            {
                                TINX++
                                Continue
                            }
                        }

                        If (((TGBR == 0xFFFFFFFF) || (TGBR == GPUB)))
                        {
                            RETV = TSTV /* \_SB_.PC00.LPCB.EC__.HKEY.GICT.TSTV */
                            NOTF = Zero
                            ADBG (" ------Matched ------")
                            ADBG (Concatenate ("Matched TINX=", ToHexString (TINX)))
                            ADBG (Concatenate ("Selected Index=", ToHexString ((CINX + TINX))))
                            ADBG (Concatenate ("TMID=", ToHexString (TMID)))
                            ADBG (Concatenate ("TICF=", ToHexString (TICF)))
                            ADBG (Concatenate ("TICC=", ToHexString (TICC)))
                            ADBG (Concatenate ("TCFM=", ToHexString (TCFM)))
                            ADBG (Concatenate ("TGID=", ToHexString (TGID)))
                            ADBG (Concatenate ("TGBR=", ToHexString (TGBR)))
                            ADBG (Concatenate ("TSTT=", ToHexString (TSTT)))
                            ADBG (Concatenate ("TSTV=", ToHexString (TSTV)))
                            ADBG (Concatenate ("MPTD=", ToHexString (MPTD)))
                            ADBG (Concatenate ("SettingType=", ToHexString (Arg1)))
                            ADBG (Concatenate ("SettingValue=", ToHexString (RETV)))
                            Break
                        }

                        TINX++
                    }

                    If ((NOTF == Zero))
                    {
                        Break
                    }

                    SPTI++
                }

                MPTI++
            }

            ADBG (" ------ GICT Exit ------")
            Return (RETV) /* \_SB_.PC00.LPCB.EC__.HKEY.GICT.RETV */
        }

        Method (SICT, 2, Serialized)
        {
            Name (CASV, Ones)
            Switch (ToInteger (Arg1))
            {
                Case (One)
                {
                    If ((NDPT == One))
                    {
                        CASV = GICT (Arg0, One)
                        If ((CASV != Ones))
                        {
                            PPL1 = CASV /* \_SB_.PC00.LPCB.EC__.HKEY.SICT.CASV */
                            PL1E = One
                            ADBG (Concatenate ("PC00.PPL1 =", ToHexString (PPL1)))
                        }
                        Else
                        {
                            ADBG ("Didn\'t found MMIO PL1 setting")
                        }
                    }
                    Else
                    {
                        ADBG ("Intel DTT Installed can\'t change MMIO PL1.")
                    }
                }
                Case (0x03)
                {
                    CASV = GICT (Arg0, 0x03)
                    If ((CASV != Ones))
                    {
                        If ((CASV != TTCI))
                        {
                            TTCI = CASV /* \_SB_.PC00.LPCB.EC__.HKEY.SICT.CASV */
                        }

                        ADBG (Concatenate ("Fan config id = ", ToHexString (TTCI)))
                    }
                    Else
                    {
                        ADBG ("Didn\'t found Fan config setting")
                    }
                }
                Case (0x04)
                {
                    Name (OEMI, 0xFF)
                    CASV = GICT (Arg0, 0x04)
                    If ((CASV != Ones))
                    {
                        If ((CASV && 0xFF00))
                        {
                            OEMI = ((CASV & 0xFF00) >> 0x08)
                        }
                        Else
                        {
                            OEMI = CASV /* \_SB_.PC00.LPCB.EC__.HKEY.SICT.CASV */
                        }

                        ADBG (Concatenate ("Oem icfunc =", ToHexString (OEMI)))
                        Switch (ToInteger (OEMI))
                        {
                            Case (0x0D)
                            {
                                OEMV [0x12] = (CASV & 0xFF)
                            }
                            Default
                            {
                                Break
                            }

                        }
                    }
                    Else
                    {
                        ADBG ("Didn\'t found OEM variable setting")
                    }
                }
                Case (0x05)
                {
                    CASV = GICT (Arg0, 0x05)
                    If ((CASV != Ones))
                    {
                        If ((CASV != DPNT))
                        {
                            DPNT = CASV /* \_SB_.PC00.LPCB.EC__.HKEY.SICT.CASV */
                        }
                    }
                }
                Case (0x07)
                {
                    CASV = GICT (Arg0, 0x07)
                    If ((CASV != Ones))
                    {
                        SPCP (0x07, CASV)
                        ADBG (Concatenate ("TYPE_PECI_PKG_PL1 = ", ToHexString (CASV)))
                    }
                    Else
                    {
                        ADBG ("Didn\'t found TYPE_PECI_PKG_PL1 setting")
                    }
                }
                Case (0x08)
                {
                    CASV = GICT (Arg0, 0x08)
                    If ((CASV != Ones))
                    {
                        SPCP (0x08, CASV)
                        ADBG (Concatenate ("TYPE_PECI_PKG_PL2 = ", ToHexString (CASV)))
                    }
                    Else
                    {
                        ADBG ("Didn\'t found TYPE_PECI_PKG_PL2 setting")
                    }
                }
                Case (0x09)
                {
                    CASV = GICT (Arg0, 0x09)
                    If ((CASV != Ones))
                    {
                        SPCP (0x09, CASV)
                        ADBG (Concatenate ("TYPE_PECI_PKG_PL4 = ", ToHexString (CASV)))
                    }
                    Else
                    {
                        ADBG ("Didn\'t found TYPE_PECI_PKG_PL4 setting")
                    }
                }
                Case (0x0A)
                {
                    CASV = GICT (Arg0, 0x0A)
                    If ((CASV != Ones))
                    {
                        SPCP (0x0A, CASV)
                        ADBG (Concatenate ("TYPE_PECI_PSYS_PL1 = ", ToHexString (CASV)))
                    }
                    Else
                    {
                        ADBG ("Didn\'t found TYPE_PECI_PSYS_PL1 setting")
                    }
                }
                Case (0x0B)
                {
                    CASV = GICT (Arg0, 0x0B)
                    If ((CASV != Ones))
                    {
                        SPCP (0x0B, CASV)
                        ADBG (Concatenate ("TYPE_PECI_PSYS_PL2 = ", ToHexString (CASV)))
                    }
                    Else
                    {
                        ADBG ("Didn\'t found TYPE_PECI_PSYS_PL2 setting")
                    }
                }
                Default
                {
                    ADBG ("Type is not defined.")
                }

            }
        }

        Method (SPCP, 2, Serialized)
        {
            ADBG (Concatenate ("Set PECI Power Limit Type =", ToHexString (Arg0)))
            Switch (ToInteger (Arg0))
            {
                Case (0x07)
                {
                    PPSL = One
                }
                Case (0x08)
                {
                    PPSL = 0x02
                }
                Case (0x09)
                {
                    PPSL = 0x09
                }
                Case (0x0A)
                {
                    PPSL = 0x06
                }
                Case (0x0B)
                {
                    PPSL = 0x07
                }
                Default
                {
                    Return (0xFF)
                }

            }

            Local0 = ((Arg1 & 0xFFFF) & 0xFF)
            Local1 = ((Arg1 & 0xFFFF) >> 0x08)
            ADBG (Concatenate ("Set PECI PPBD =", ToHexString (Local0)))
            ADBG (Concatenate ("Set PECI PPBC =", ToHexString (Local1)))
            If ((Arg1 && 0x00FF0000))
            {
                Local2 = ((Arg1 & 0x00FF0000) >> 0x10)
                PPBE = Local2
                ADBG (Concatenate ("Set PECI PPBE =", ToHexString (Local2)))
            }

            PPBD = Local0
            PPBC = Local1
            Return (Zero)
        }

