                            {
                                Offset (0x84),
                                PMEC,   8
                            }

                            OperationRegion (UAB0, SystemMemory, (BAR0 & 0xFFFFFFFFFFFFF000), 0x85)
                            Field (UAB0, ByteAcc, Lock, Preserve)
                            {
                                DLL,    8,
                                DLH,    8,
                                FCR,    8,
                                LCR,    8,
                                MCR,    8,
                                Offset (0x81),
                                PPRR,   8
                            }

                            Field (UAB0, DWordAcc, NoLock, Preserve)
                            {
